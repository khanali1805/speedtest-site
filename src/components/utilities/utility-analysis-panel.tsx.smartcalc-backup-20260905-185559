"use client";

import { useState } from "react";
import {
  analyzeUtilityReading,
  compareUtilityPeriods,
  estimateAmountFromRate,
  verifyMeterUsage,
} from "@/lib/utility-analysis";

type UtilityKind = "electricity" | "gas" | "water";

export default function UtilityAnalysisPanel({ kind }: { kind: UtilityKind }) {
  const [current, setCurrent] = useState("");
  const [previous, setPrevious] = useState("");
  const [rate, setRate] = useState("");
  const [fixed, setFixed] = useState("");
  const [meterStart, setMeterStart] = useState("");
  const [meterEnd, setMeterEnd] = useState("");
  const [billUsage, setBillUsage] = useState("");
  const [result, setResult] = useState<Record<string, unknown> | null>(null);
  const [error, setError] = useState("");

  const unit = kind === "electricity" ? "kWh" : kind === "gas" ? "units" : "m3";

  function runLocal() {
    setError("");
    try {
      const c = Number(current);
      const p = Number(previous);
      const r = Number(rate || 0);
      const f = Number(fixed || 0);
      if (!Number.isFinite(c) || c < 0) throw new Error("Current usage must be a valid non-negative number.");
      if (!Number.isFinite(p) || p < 0) throw new Error("Previous usage must be a valid non-negative number.");

      const reading = analyzeUtilityReading({ kind, current: c, previous: p });
      const comparison = compareUtilityPeriods({ previous: p, current: c });
      const estimate = estimateAmountFromRate(c, r, f);

      setResult({
        reading,
        comparison,
        estimate,
      });
    } catch (e) {
      setError(e instanceof Error ? e.message : "Analysis failed.");
    }
  }

  async function verify() {
    setError("");
    try {
      const start = Number(meterStart);
      const end = Number(meterEnd);
      const usage = Number(billUsage);
      if (![start, end, usage].every(Number.isFinite)) throw new Error("Enter valid meter and bill values.");

      const local = verifyMeterUsage({ meterStart: start, meterEnd: end, billUsage: usage });
      const response = await fetch("/api/utilities/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ meterStart: start, meterEnd: end, billUsage: usage }),
      });
      const payload = await response.json();
      if (!response.ok) throw new Error(payload?.error || "Verification API failed.");

      setResult({ localVerification: local, apiVerification: payload });
    } catch (e) {
      setError(e instanceof Error ? e.message : "Verification failed.");
    }
  }

  return (
    <section className="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div className="text-xs font-black uppercase tracking-[0.2em] text-slate-500">Real utility analysis</div>
      <h2 className="mt-2 text-2xl font-black capitalize">{kind} usage</h2>
      <p className="mt-2 text-sm text-slate-500">Enter values from an actual bill or meter. SmartCalc calculates from those values only.</p>

      <div className="mt-6 grid gap-4 sm:grid-cols-2">
        <Input label={`Current usage (${unit})`} value={current} setValue={setCurrent} />
        <Input label={`Previous usage (${unit})`} value={previous} setValue={setPrevious} />
        <Input label="Rate per unit" value={rate} setValue={setRate} />
        <Input label="Fixed charge" value={fixed} setValue={setFixed} />
      </div>

      {error && <div className="mt-4 rounded-xl border border-rose-200 bg-rose-50 p-3 text-sm font-semibold text-rose-700">{error}</div>}

      <div className="mt-5 flex flex-wrap gap-3">
        <button type="button" onClick={runLocal} className="rounded-xl bg-slate-950 px-5 py-3 text-sm font-black text-white">Analyze usage</button>
      </div>

      <div className="mt-8 border-t border-slate-100 pt-6">
        <h3 className="font-black">Meter vs bill verification</h3>
        <div className="mt-4 grid gap-4 sm:grid-cols-3">
          <Input label="Meter start" value={meterStart} setValue={setMeterStart} />
          <Input label="Meter end" value={meterEnd} setValue={setMeterEnd} />
          <Input label="Bill usage" value={billUsage} setValue={setBillUsage} />
        </div>
        <button type="button" onClick={verify} className="mt-4 rounded-xl bg-slate-100 px-5 py-3 text-sm font-black text-slate-800">Verify bill usage</button>
      </div>

      {result && (
        <pre className="mt-6 overflow-auto rounded-2xl bg-slate-950 p-4 text-xs leading-5 text-slate-100">
          {JSON.stringify(result, null, 2)}
        </pre>
      )}
    </section>
  );
}

function Input({ label, value, setValue }: { label: string; value: string; setValue: (value: string) => void }) {
  return (
    <label className="block">
      <span className="mb-1 block text-xs font-black uppercase tracking-wider text-slate-500">{label}</span>
      <input value={value} onChange={(e) => setValue(e.target.value)} inputMode="decimal"
        className="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 outline-none focus:border-slate-500" />
    </label>
  );
}